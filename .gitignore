# Environment / secrets — NEVER commit these.
# ".evn" is the misspelled file already in this project; keep both spellings.
.evn
.evn.*
.env
.env.*
!.env.example

# Node modules
node_modules/
package-lock.json

# Next.js build output
.next/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Optional: if using TurboRepo or monorepo
turbo/

# Raw unoptimised photo originals. The versions actually served live in
# public/asset/photos/ — these are the untouched Facebook downloads, kept
# locally as masters but not worth carrying in the repo.
public/Image/